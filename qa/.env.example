# 新能源知识图谱问答系统环境变量示例
# 复制本文件为 .env 并填写真实 API Key / Neo4j 密码后即可启用完整功能

# ==================== Neo4j 知识图谱配置（可选）====================
# 若本地已启动 Neo4j，取消下面注释并填写真实密码，即可启用 KG+RAG
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-neo4j-password

# ==================== DashScope（通义千问，默认）====================
# 访问 https://dashscope.aliyun.com/ 获取 API Key
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-turbo
EMBEDDING_MODEL=text-embedding-v3
RERANK_MODEL=gte-rerank-v2

# ==================== OpenAI 兼容接口（可选）====================
# 若使用本地模型或其他厂商 OpenAI 兼容接口，取消下面注释并填写
# OPENAI_API_BASE=https://your-api-base.com/v1
# OPENAI_API_KEY=your-openai-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# ==================== LLM 参数（可选）====================
# LLM_TIMEOUT=30
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.3

# ==================== 服务参数（可选）====================
# APP_HOST=127.0.0.1
# APP_PORT=8000

# ==================== 实体识别配置（可选）====================
# rapidfuzz 模糊匹配阈值（0-100），默认 85；提高可减少误召回，降低可增加召回
# ENTITY_FUZZY_THRESHOLD=85

# ==================== 会话记忆配置（可选）====================
# 每个会话保留的最大问答轮数，默认 5；设为 0 则关闭多轮记忆
# MAX_HISTORY_ROUNDS=5

# ==================== 调试开关（可选）====================
# QA_DEBUG=false

# ==================== 日志配置（可选）====================
# 日志级别：DEBUG / INFO / WARNING / ERROR
# LOG_LEVEL=INFO
# 日志文件路径，留空则仅输出到控制台
# LOG_FILE=

# ==================== 文档摄取与向量检索（可选）====================
# Embedding 模型与维度（DashScope text-embedding-v3 默认 1024 维）
# EMBEDDING_MODEL=text-embedding-v3
# EMBEDDING_DIMENSION=1024
# EMBED_BATCH_SIZE=10
# Qdrant 地址（本地默认 localhost:6333；docker compose 用 QDRANT_HOST=qdrant）
# QDRANT_URL=http://localhost:6333
# QDRANT_COLLECTION=newenergy_docs
# 语义切分参数（字符数）
# CHUNK_SIZE=600
# CHUNK_OVERLAP=80
# 问答时混合检索注入 Prompt 的参考资料条数
# RETRIEVER_TOP_K=5
# 重排模型（DashScope gte-rerank-v2；不可用时改 gte-rerank）
# RERANK_MODEL=gte-rerank-v2
